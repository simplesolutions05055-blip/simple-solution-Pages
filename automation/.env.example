# =========================================================================
# Simple Solutions — Article Automation Pipeline
# Required Environment Variables
# =========================================================================
# Copy to .env.local for local dev, or add to Vercel project settings for production.
# Get the values from each service's dashboard (instructions in automation/README.md).

# --- Supabase (database for drafts, queue, approval state) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...   # server-side ONLY (full access)
SUPABASE_ANON_KEY=eyJhbGciOiJI...           # optional, for read-only client features

# --- Resend (transactional email — approval requests) ---
RESEND_API_KEY=re_...
APPROVAL_FROM_EMAIL=articles@simple-solution.co.il
APPROVAL_TO_EMAIL=simple.solutions05055@gmail.com

# --- JWT (sign approval/revision tokens for email links) ---
JWT_SECRET=                                  # any 64-char random string (openssl rand -hex 32)

# --- Webhook secret (Make ↔ Vercel handshake) ---
WEBHOOK_SECRET=                              # any 32-char random string

# --- GitHub (commit + push approved articles back to this repo) ---
GITHUB_TOKEN=ghp_...                         # fine-grained token, write to this repo only
GITHUB_OWNER=simplesolutions05055-blip
GITHUB_REPO=simple-solution-Pages
GITHUB_BRANCH=main                           # production branch

# --- Public URL for the live site (used in approval emails + canonical) ---
SITE_URL=https://www.simple-solution.co.il

# --- Claude API (article generation — used by Make scenario, not this server) ---
# Set this in Make.com, not here, but kept for reference:
# ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Google Gemini Image / Nano Banana (image generation — used by Make scenario) ---
# Same — set in Make.com:
# GEMINI_API_KEY=AIzaSy...

# --- Cloudinary (image hosting — used by Make scenario) ---
# Same — set in Make.com:
# CLOUDINARY_CLOUD_NAME=simple-solutions
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
